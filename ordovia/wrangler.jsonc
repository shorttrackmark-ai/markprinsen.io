{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordovia",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },
  // The Worker serves /api/*; everything else is the static app in ./public
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ordovia",
      // Replace with the id printed by: npx wrangler d1 create ordovia
      "database_id": "c8e3a1b8-502c-438a-86df-e3f7ef292e4d",
      "migrations_dir": "migrations"
    },
    // The example (one address: the "Try the example" button switches this browser to this database; it resets every night)
    { "binding": "DB_DEMO", "database_name": "ordovia-demo", "database_id": "2642f888-ce9e-4976-848b-7b811c61d68f", "migrations_dir": "migrations" }
  ],
  // Hourly job: marks overdue tasks, fires reminder webhooks, and at 03:xx UTC resets the example
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ordovia-files" }, { "binding": "FILES_DEMO", "bucket_name": "ordovia-demo-files" }],
  "triggers": { "crons": ["17 * * * *"] }
}
